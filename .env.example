# Digital ASHA – Rural Child Health & Vaccination Management System
# Environment Configuration

APP_NAME="Digital ASHA"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="digital_asha_super_secret_key_change_in_production_jwt_key_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days for convenience in rural field operation

# Database
# SQLite default (zero-setup relational DB). Can also use PostgreSQL: postgresql://user:password@localhost/digital_asha
DATABASE_URL="sqlite:///./digital_asha.db"

# CORS
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:3000"]
